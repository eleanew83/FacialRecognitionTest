{
    "main": {
        "experiment": "macaque_identification",
        "datasets": ["/data"]
    },
    "model": {
        "input_width": 224,
        "input_height": 224,
        "img_preprocess": "crop",
        "embedding_size": 256,
        "cutoff_classes": true,
        "backbone": "vit"
    },
    "train": {
        "dataset": {
            "path": "/data/train"
        },
        "model_save_path": "/models",
        "train_val_split_overlapping": true,
        "batch_size": 64,
        "learning_rate": 1e-5,
        "nb_epochs": 30,
        "sampler": "ensure_positive",
        "class_sampler_config": {
            "samples_per_class": 8,
            "classes_per_batch": 16
        },
        "use_augmentation": true,
        "augment_config": {
            "use_erase": false,
            "use_intensity": true,
            "use_geometric": true
        },
        "l2_factor": null
    },
    "create_db": {
        "image_folder": "/data/database_set",
        "db_path": "/data/db/",
        "model_path": null
    },
    "eval": {
        "db_path": "/data/db/",
        "model_path": null,
        "img_folder": "/data/eval"
    }
} 